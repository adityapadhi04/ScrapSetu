# ScrapSetu — Backend Environment Variables
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to version control.

# ─── Cashfree Sandbox Credentials ───────────────────────────────────────────
CASHFREE_CLIENT_ID=your_cashfree_sandbox_client_id_here
CASHFREE_CLIENT_SECRET=your_cashfree_sandbox_client_secret_here
CASHFREE_ENVIRONMENT=sandbox
CASHFREE_BASE_URL=https://sandbox.cashfree.com/pg
CASHFREE_WEBHOOK_SECRET=your_cashfree_sandbox_client_secret_here

# ─── Razorpay Test Credentials ───────────────────────────────────────────────
# Obtain from: https://dashboard.razorpay.com → Settings → API Keys → Test Mode
# Key ID is safe to use in frontend. Key Secret MUST stay only in this file.
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX

# ─── ScrapSetu Backend ───────────────────────────────────────────────────────
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
